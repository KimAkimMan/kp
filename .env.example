DATABASE_USER="user"
DATABASE_PASSWORD="password"
DATABASE_NAME="your_database"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

JWT_SECRET="your_jwt_secret_key"
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api"
NODE_ENV="development"

# Development login seed (do not use a default password in production)
SEED_LOGIN_PASSWORD="Password123!"

STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=........
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=.....
R2_BUCKET=.......

# Public URL for accessing uploaded files (client-side)
# Format: https://pub-xxxxxxxxxxxx.r2.dev or custom domain
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_R2_BUCKET=
NEXT_PUBLIC_R2_ACCOUNT_ID=
